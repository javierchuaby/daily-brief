# Daily Brief Configuration - Environment Variables
# Copy this file to .env and fill in your credentials
# DO NOT commit .env to git!

# Canvas API Configuration
CANVAS_API_TOKEN=your-canvas-api-token-here
CANVAS_BASE_URL=https://canvas.nus.edu.sg

# Coursemology Credentials
COURSEMOLOGY_USERNAME=your-coursemology-username-or-email-here
COURSEMOLOGY_PASSWORD=your-coursemology-password-here
COURSEMOLOGY_COURSE_ID=12345

# Gmail App Password (for sending emails)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your-gmail-app-password-here
GMAIL_SENDER=example@gmail.com
RECIPIENT_EMAIL=your-email@u.nus.edu

# Canvas course IDs (NUS) - comma-separated
CANVAS_COURSES=CS2102:12345,CS2107:12346,CS2109S:12347,CS3103:12348,CS4226:12349
